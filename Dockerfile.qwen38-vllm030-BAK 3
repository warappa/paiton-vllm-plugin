# ============================================================
# Paiton Qwen3.8 DFlash2 on vLLM 0.30.0
#
# Build strategy:
#   - clean ROCm 10.0 / PyTorch 2.13 base
#   - vLLM 0.30.0 built against that same ROCm toolchain
#   - Paiton 0.3.2.dev2026091801 plugin, installed without its
#     vLLM 0.29 / Torch 2.12 dependency constraints
#   - ROCm-10-compatible AITER payload copied from the qualified
#     Paiton 0.29 donor image
#   - amd-quark + radiance dispatcher
#
# Deliberately NOT included:
#   - paiton_runtime_compat / its vLLM-0.29 source overlays
#   - PAITON_RUNTIME_COMPAT_FLOW=1
#   - experimental PAITON_DFLASH_NATIVE runtime/manifests
#   - the nonexistent /opt/paiton/runtime/dflash-down bundle
#
# The runtime configuration below mirrors the qualified Paiton
# Qwen3.8 200K image as closely as possible, while retaining the
# clean vLLM 0.30 / ROCm 10 userspace.
# ============================================================

FROM ghcr.io/eliovp/paiton-vllm-plugin:qwen38-rocm10-vllm029-200k-20260918-r2@sha256:32dab97330ea84b86967537d25f91878c30f21ff844f71369508c5a049b89178 AS paiton_donor

# Clean AMD ROCm 10 / PyTorch 2.13 environment.
FROM rocm/pytorch:rocm10.0_ubuntu24.04_py3.12_pytorch_release_2.13.0

ENV VLLM_TARGET_DEVICE=rocm \
    PYTORCH_ROCM_ARCH=gfx1201 \
    MAX_JOBS=4

# Match the qualified Paiton model-plugin path, while explicitly
# keeping the old vLLM-0.29 compatibility/native-DFlash mechanisms off.
ENV VLLM_DISABLE_PAITON_PLATFORM=1 \
    VLLM_PLUGINS=register_paiton_models \
    PAITON_RUNTIME_COMPAT_FLOW=0 \
    PAITON_DFLASH_NATIVE=0

# ------------------------------------------------------------
# Install the ROCm 10.0 development SDK needed to compile vLLM.
# ------------------------------------------------------------

RUN pip install --no-cache-dir \
      --index-url https://stable.repo.amd.com/rocm/whl-next/ \
      "rocm[devel,device-gfx1201]==10.0.0" && \
    rocm-sdk init

RUN test -f \
    /opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib/cmake/hip-lang/hip-lang-config.cmake && \
    echo "HIP CMake package found" && \
    /opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel/bin/amdclang++ --version

# Make CMake use the complete development SDK, not _rocm_sdk_core.
ENV ROCM_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel \
    HIP_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel \
    CMAKE_PREFIX_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib/cmake:$CMAKE_PREFIX_PATH \
    PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel/bin:$PATH

# ------------------------------------------------------------
# Build vLLM 0.30.0
# ------------------------------------------------------------

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        build-essential \
        cmake \
        ninja-build && \
    rm -rf /var/lib/apt/lists/*

RUN git clone \
        --depth 1 \
        --branch v0.30.0 \
        https://github.com/vllm-project/vllm.git \
        /tmp/vllm && \
    cd /tmp/vllm && \
    pip install -r requirements/rocm.txt && \
    VLLM_TARGET_DEVICE=rocm \
    PYTORCH_ROCM_ARCH=gfx1201 \
    MAX_JOBS=4 \
    pip install --no-build-isolation . && \
    rm -rf /tmp/vllm

# ------------------------------------------------------------
# Install the exact Paiton plugin wheel from the qualified
# vLLM-0.29 image, but WITHOUT its declared vLLM/Torch deps.
# ------------------------------------------------------------

COPY --from=paiton_donor \
    /opt/paiton/wheels/paiton_vllm_plugin-0.3.2.dev2026091801-py3-none-any.whl \
    /tmp/

RUN pip install --no-deps \
    /tmp/paiton_vllm_plugin-0.3.2.dev2026091801-py3-none-any.whl && \
    rm -f /tmp/paiton_vllm_plugin-0.3.2.dev2026091801-py3-none-any.whl

# ------------------------------------------------------------
# Copy the ROCm-10-compatible AITER payload from the donor.
# The donor contains the already-built gfx1201-capable package;
# do not replace it with a public wheel from another ROCm stack.
# ------------------------------------------------------------

COPY --from=paiton_donor \
    /usr/local/lib/python3.12/dist-packages/aiter \
    /opt/venv/lib/python3.12/site-packages/aiter

COPY --from=paiton_donor \
    /usr/local/lib/python3.12/dist-packages/aiter_meta \
    /opt/venv/lib/python3.12/site-packages/aiter_meta

COPY --from=paiton_donor \
    /usr/local/lib/python3.12/dist-packages/flydsl \
    /opt/venv/lib/python3.12/site-packages/flydsl

COPY --from=paiton_donor \
    /usr/local/lib/python3.12/dist-packages/flydsl-0.3.2.dist-info \
    /opt/venv/lib/python3.12/site-packages/flydsl-0.3.2.dist-info

COPY --from=paiton_donor \
    /usr/local/lib/python3.12/dist-packages/amd_aiter-0.1.21.post1.dist-info \
    /opt/venv/lib/python3.12/site-packages/amd_aiter-0.1.21.post1.dist-info

# AITER's pure-Python runtime dependencies that are not guaranteed to
# be present in the clean PyTorch base/vLLM environment.
RUN pip install --no-cache-dir \
    "pybind11>=3.0.1" \
    ninja \
    pandas \
    einops \
    psutil \
    packaging

# ------------------------------------------------------------
# Paiton's shared Radiance dispatcher module.
# This is a loose Python module rather than a normal distribution.
# ------------------------------------------------------------

COPY --from=paiton_donor \
    /usr/local/lib/python3.12/dist-packages/radiance_kernels.py \
    /opt/venv/lib/python3.12/site-packages/radiance_kernels.py

# ------------------------------------------------------------
# AMD Quark is installed normally.  The donor reports 0.12.post1.
# ------------------------------------------------------------

RUN pip install --no-cache-dir \
    amd-quark==0.12.post1

# ------------------------------------------------------------
# Runtime/cache configuration matching the qualified 200K Paiton
# image.  Keep the ROCm SDK paths from the CLEAN base above; do not
# import the donor image's old SDK paths into this image.
# ------------------------------------------------------------

ENV AITER_ROCM_ARCH=gfx942;gfx950 \
    AITER_ROOT_DIR=/cache/aiter \
    AMDGPU_TARGETS=gfx1201 \
    GPU_ARCHS=gfx1201 \
    HIP_ARCHITECTURES=gfx1201 \
    HIP_PLATFORM=amd \
    HIP_VISIBLE_DEVICES=0 \
    ROCR_VISIBLE_DEVICES=0 \
    NCCL_PROTO=Simple \
    OMP_NUM_THREADS=6 \
    HSA_NO_SCRATCH_RECLAIM=1 \
    HSA_ENABLE_IPC_MODE_LEGACY=1 \
    PYTORCH_NVML_BASED_CUDA_CHECK=1 \
    SAFETENSORS_FAST_GPU=1 \
    TOKENIZERS_PARALLELISM=false \
    XDG_CACHE_HOME=/cache \
    HF_HOME=/cache/hf \
    VLLM_CACHE_ROOT=/cache/vllm \
    TORCHINDUCTOR_CACHE_DIR=/cache/inductor \
    TORCHINDUCTOR_COMPILE_THREADS=1 \
    TRITON_CACHE_DIR=/cache/triton \
    TRITON_CACHE_AUTOTUNING=1 \
    VLLM_NO_USAGE_STATS=1 \
    VLLM_LOGGING_LEVEL=INFO \
    REFERENCE_SAFETENSORS_PREAD=1

# The official image is offline at inference time because its model
# and tokenizer are supplied locally.  Keep these off by default if
# you need to download anything at runtime; change to 1 for a strict
# offline deployment.
ENV HF_HUB_OFFLINE=0 \
    TRANSFORMERS_OFFLINE=0

# ------------------------------------------------------------
# vLLM / AITER selection used by the qualified image.
# ------------------------------------------------------------

ENV VLLM_ROCM_USE_AITER=1 \
    VLLM_ROCM_USE_AITER_FP4BMM=0 \
    VLLM_ROCM_USE_AITER_FP8BMM=0 \
    VLLM_ROCM_USE_AITER_LINEAR=0 \
    VLLM_ROCM_USE_AITER_MHA=0 \
    VLLM_ROCM_USE_AITER_MLA=0 \
    VLLM_ROCM_USE_AITER_MOE=0 \
    VLLM_ROCM_USE_AITER_RMSNORM=0 \
    VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION=1

# ------------------------------------------------------------
# Paiton/Radiance Qwen3.8 MXFP4 + R4D runtime settings.
# These mirror the working qualified 200K image rather than the
# old vLLM-0.29 compatibility mechanism.
# ------------------------------------------------------------

ENV R4D_ATTN_FP8=3 \
    RADIANCE_AR_MAX_KB=45056 \
    RADIANCE_AR_OVERLAP=0 \
    RADIANCE_AR_QBITS=6 \
    RADIANCE_AR_QNB=96 \
    RADIANCE_AR_QNT=1024 \
    RADIANCE_DRAFT_RERANK=80 \
    RADIANCE_DRAFT_SCHEDULE=1:8,2:7,4:6,8:5,16:4 \
    RADIANCE_DRAFT_TAU=0.20 \
    RADIANCE_DYNAMIC_DRAFT=1 \
    RADIANCE_DYNAMIC_WIDTH=1 \
    RADIANCE_DYNW_ALPHA=0.35 \
    RADIANCE_DYNW_MARGIN=2 \
    RADIANCE_DYNW_MIN=2 \
    RADIANCE_DYNW_MIN_BATCH=3 \
    RADIANCE_FAST_DRAFT=1 \
    RADIANCE_FP8_STREAM=1 \
    RADIANCE_FP8_STREAM_TP1=1 \
    RADIANCE_FUSE_RMS_QUANT=1 \
    RADIANCE_GDN_EMPTY_OUT=0 \
    RADIANCE_GDN_FUSED_MAX_ITEMS=48 \
    RADIANCE_GDN_FUSED_UPDATE=1 \
    RADIANCE_GDN_LAZY=1 \
    RADIANCE_GDN_MERGE_INPROJ=1 \
    RADIANCE_GDN_NORM_QUANT=1 \
    RADIANCE_GDN_PATHS=both \
    RADIANCE_GDN_STRIDED_GATES=0 \
    RADIANCE_GFX_ARCH=gfx1201 \
    RADIANCE_MXFP4=1 \
    RADIANCE_MXFP4_A_TILED_MIN_M=513 \
    RADIANCE_MXFP4_DECODE_MAX_M=64 \
    RADIANCE_MXFP4_DECODE_NT=1 \
    RADIANCE_MXFP4_EPIFAST=1 \
    RADIANCE_MXFP4_HOIST_QUANT=1 \
    RADIANCE_MXFP4_R4D_DECODE_MAX_M=0 \
    RADIANCE_MXFP4_SANITIZE=0 \
    RADIANCE_MXFP4_TN4_MIN_M=2048 \
    RADIANCE_MXFP4_TRACED_QUANT=1 \
    RADIANCE_MXFP4_W4A8=1 \
    RADIANCE_MXFP4_W4A8_MIN_M=0 \
    RADIANCE_MXFP4_WPERM=1 \
    RADIANCE_NVFP4_BF16_LAYERS=in_proj_ba \
    RADIANCE_NVFP4_EXP=mse \
    RADIANCE_NVFP4_FP8_LAYERS=mxfp4 \
    RADIANCE_NVFP4_LMHEAD=bf16 \
    RADIANCE_NVFP4_MXFP4=1 \
    RADIANCE_PRESHUFFLE=1 \
    RADIANCE_R4D_REPORT=1 \
    RADIANCE_RMS_QUANT_FUSION=1 \
    RADIANCE_RUN_BWTEST=0 \
    RADIANCE_SKINNY_GEMM=1 \
    RADIANCE_TOPK_TRITON_MIN_ROWS=1 \
    RADIANCE_TP_PAD=0 \
    RADIANCE_USE_R4D=1 \
    RADIANCE_USE_R4D_AR=1 \
    RADIANCE_USE_R4D_AR_QUANT=1 \
    RADIANCE_VERIFY_HEAD=1 \
    RADIANCE_VERIFY_HEAD_INIT_TRY_ORIGINAL=1 \
    RADIANCE_VERIFY_HEAD_MAX_M=32

RUN mkdir -p \
    /app \
    /cache/aiter \
    /cache/hf \
    /cache/inductor \
    /cache/triton \
    /cache/vllm

WORKDIR /app

# ------------------------------------------------------------
# Build-time package sanity check.
# Do NOT import torch/vllm here because GPU access is unavailable
# during a normal Podman image build.
# ------------------------------------------------------------

RUN python3 - <<'PY'
from importlib.metadata import version
import importlib.util

print("torch:", version("torch"))
print("vllm:", version("vllm"))
print("paiton:", version("paiton-vllm-plugin"))
print("aiter:", version("amd-aiter"))
print("quark:", version("amd-quark"))

assert version("vllm") == "0.30.0+rocm100"
assert version("torch") == "2.13.0+rocm10.0.0"
assert version("paiton-vllm-plugin") == "0.3.2.dev2026091801"
assert version("amd-aiter") == "0.1.21.post1"
assert version("amd-quark") == "0.12.post1"

assert importlib.util.find_spec("radiance_kernels")
assert importlib.util.find_spec("aiter")
assert importlib.util.find_spec("aiter_meta")
assert importlib.util.find_spec("flydsl")

print("Build-time validation OK")
PY

# ------------------------------------------------------------
# Match the qualified Paiton 200K Qwen3.8 serving defaults.
# /models/target and /models/draft are expected to be mounted by
# the runtime command.
# ------------------------------------------------------------

ENTRYPOINT ["/usr/local/bin/vllm"]

CMD ["serve", "/models/target", \
     "--tokenizer", "/models/target", \
     "--served-model-name", "Qwen3.8", \
     "--host", "127.0.0.1", \
     "--port", "18982", \
     "--tensor-parallel-size", "1", \
     "--dtype", "bfloat16", \
     "--max-model-len", "200000", \
     "--max-num-seqs", "1", \
     "--max-num-batched-tokens", "4096", \
     "--kv-cache-dtype", "fp8", \
     "--kv-cache-memory-bytes", "6979321856", \
     "--gpu-memory-utilization", "0.98", \
     "--no-enable-prefix-caching", \
     "--enable-chunked-prefill", \
     "--language-model-only", \
     "--safetensors-load-strategy", "lazy", \
     "--attention-backend", "R4D", \
     "--compilation-config", "{\"cudagraph_capture_sizes\": [1, 2, 4, 8], \"pass_config\": {\"fuse_norm_quant\": true, \"fuse_act_quant\": true}}", \
     "--speculative-config", "{\"method\": \"dflash\", \"model\": \"/models/draft\", \"num_speculative_tokens\": 7, \"draft_tensor_parallel_size\": 1, \"attention_backend\": \"TRITON_ATTN\", \"max_model_len\": 200000, \"disable_padded_drafter_batch\": true, \"draft_sample_method\": \"greedy\"}", \
     "--mamba-cache-mode", "none", \
     "--mamba-cache-dtype", "bfloat16", \
     "--mamba-ssm-cache-dtype", "float16", \
     "--no-async-scheduling", \
     "--enable-auto-tool-choice", \
     "--tool-call-parser", "qwen3_coder", \
     "--reasoning-parser", "qwen3", \
     "--override-generation-config", "{\"temperature\": 0.7, \"top_p\": 0.95, \"top_k\": 20}", \
     "--seed", "42"]
