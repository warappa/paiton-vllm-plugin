# Keep Paiton's current ROCm 10 + Qwen3.8 DFlash2 runtime as the base.
# This is the current qualified 200K image.
FROM ghcr.io/eliovp/paiton-vllm-plugin:qwen38-rocm10-vllm029-200k-20260918-r2@sha256:32dab97330ea84b86967537d25f91878c30f21ff844f71369508c5a049b89178

ENV VLLM_TARGET_DEVICE=rocm \
    PYTORCH_ROCM_ARCH=gfx1201 \
    MAX_JOBS=4

# vLLM 0.30.0 requires PyTorch 2.13.0.
# Use AMD's ROCm 10.0.0 wheel specifically for gfx1201.
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install \
        --index-url https://stable.repo.amd.com/rocm/whl-next/ \
        "torch[device-gfx1201]==2.13.0+rocm10.0.0" \
        "torchvision[device-gfx1201]==0.28.0+rocm10.0.0" \
        "torchaudio==2.11.0.2+rocm10.0.0"

# Build vLLM 0.30.0 against the ROCm 10 / PyTorch 2.13 environment.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        build-essential \
        cmake \
        ninja-build && \
    rm -rf /var/lib/apt/lists/* && \
    git clone --depth 1 --branch v0.30.0 \
        https://github.com/vllm-project/vllm.git \
        /tmp/vllm && \
    cd /tmp/vllm && \
    python3 -m pip install -r requirements/rocm.txt && \
    VLLM_TARGET_DEVICE=rocm \
    PYTORCH_ROCM_ARCH=gfx1201 \
    MAX_JOBS=4 \
    python3 -m pip install --no-build-isolation . && \
    rm -rf /tmp/vllm

# Fail the build rather than leaving a silently mixed framework stack.
# disable exact vllm verssion check
ENV PAITON_RUNTIME_COMPAT_FLOW=0
RUN python3 - <<'PY'
from importlib.metadata import version

torch = version("torch")
vllm = version("vllm")

print("PyTorch:", torch)
print("vLLM:", vllm)

assert torch.startswith("2.13.0+rocm10.0.0"), torch
assert vllm == "0.30.0+rocm100", vllm
PY